# ---------------------------------------------------------------------------
# Lumen — environment template
# Copy to .env and fill in your own values: cp .env.example .env
# ---------------------------------------------------------------------------

# Required — get a free key at https://www.searchapi.io/
SEARCHAPI_KEY=your_searchapi_key_here

# Upstream API (leave as-is unless SearchApi.io changes its endpoint)
SEARCHAPI_ENDPOINT=https://www.searchapi.io/api/v1/search
SEARCHAPI_ENGINE=google

# Default search context
DEFAULT_LANGUAGE=en
DEFAULT_REGION=us

# Optional — route browser calls through your own proxy (recommended in production)
# SEARCHAPI_PROXY=https://your-worker.workers.dev/search
